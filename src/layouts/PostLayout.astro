---
import BaseLayout from './BaseLayout.astro';
import Comment from '../components/common/Comment.astro';
import TableOfContents from '../components/common/TableOfContents.astro';
import type { MarkdownHeading } from 'astro';

interface Props {
  title: string;
  description: string;
  date: Date;
  updatedDate?: Date;
  tags: string[];
  wordCount?: number;
  headings?: MarkdownHeading[];
}

const { title, description, date, updatedDate, tags, wordCount, headings = [] } = Astro.props;

const formattedDate = new Intl.DateTimeFormat('zh-CN', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
}).format(date);
---

<BaseLayout title={title} description={description}>
  <div class="flex flex-col xl:flex-row gap-6 lg:gap-8 items-start relative w-full">
    <article class="flex-1 min-w-0 w-full p-6 sm:p-10 rounded-2xl bg-white/75 dark:bg-neutral-900/75 backdrop-blur-md border border-neutral-200/80 dark:border-neutral-800/80 shadow-sm">
    <!-- 返回按钮 -->
    <a
      href="/posts"
      class="inline-flex items-center gap-1.5 text-sm font-medium text-neutral-500 hover:text-neutral-900 dark:text-neutral-400 dark:hover:text-neutral-100 mb-8 transition-colors"
    >
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path>
      </svg>
      返回文章列表
    </a>

    <!-- 文章标头 -->
    <header class="mb-10 pb-6 border-b border-neutral-200 dark:border-neutral-800">
      <h1 class="text-3xl sm:text-4xl font-extrabold tracking-tight text-neutral-900 dark:text-neutral-50 mb-4 leading-tight">
        {title}
      </h1>

      <div class="flex flex-wrap items-center gap-2.5 mb-2">
        <!-- 发布日期方框 -->
        <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-xl border border-neutral-300 dark:border-neutral-700 bg-neutral-100/90 dark:bg-neutral-800/80 shadow-sm text-neutral-800 dark:text-neutral-100 text-sm sm:text-[15px] font-semibold" title="发布日期">
          <svg class="w-4 h-4 text-sky-600 dark:text-sky-400 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
          </svg>
          <time datetime={date.toISOString()}>{formattedDate}</time>
        </div>

        <!-- 字数预估方框 -->
        {wordCount !== undefined && (
          <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-xl border border-neutral-300 dark:border-neutral-700 bg-neutral-100/90 dark:bg-neutral-800/80 shadow-sm text-neutral-800 dark:text-neutral-100 text-sm sm:text-[15px] font-semibold" title="文章字数（数字/字母两个算一个字）">
            <svg class="w-4 h-4 text-sky-600 dark:text-sky-400 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" />
            </svg>
            <span>{wordCount.toLocaleString('zh-CN')} 字</span>
          </div>
        )}

        {updatedDate && (
          <span class="text-xs text-neutral-500 dark:text-neutral-400 font-mono">
            (更新于 {new Intl.DateTimeFormat('zh-CN', { year: 'numeric', month: 'numeric', day: 'numeric' }).format(updatedDate)})
          </span>
        )}

        <div class="flex flex-wrap items-center gap-1.5 ml-auto">
          {tags.map((tag) => (
            <span class="px-2.5 py-0.5 rounded-full text-xs font-medium bg-neutral-200/70 dark:bg-neutral-800 text-neutral-700 dark:text-neutral-300 border border-neutral-300/40 dark:border-neutral-700/50">
              #{tag}
            </span>
          ))}
        </div>
      </div>
    </header>

    <!-- Markdown 正文区 -->
    <div id="article-content" class="prose dark:prose-invert max-w-none">
      <slot />
    </div>

    <!-- 评论交流区 -->
    <Comment />
  </article>

  <!-- 右侧固定悬浮目录 (桌面端 >= xl 放置在右侧) -->
  {headings && headings.length > 0 && (
    <aside class="hidden xl:block w-64 shrink-0 sticky top-24 z-10">
      <TableOfContents headings={headings} />
    </aside>
  )}
</div>

<!-- 移动端/平板端悬浮目录按钮与底部抽屉 -->
{headings && headings.length > 0 && (
  <TableOfContents headings={headings} isMobile={true} />
)}

  <script>
    function handleSearchHighlightAndScroll() {
      const url = new URL(window.location.href);
      const highlightQuery = url.searchParams.get('highlight') || url.searchParams.get('q');
      const matchPhrase = url.searchParams.get('match');
      const hash = url.hash ? decodeURIComponent(url.hash.slice(1)) : '';

      if (!highlightQuery && !matchPhrase && !hash) return;

      const prose = document.getElementById('article-content');
      if (!prose) return;

      // 清除旧高亮
      prose.querySelectorAll('.search-target-highlight').forEach((el) => {
        const parent = el.parentNode;
        if (parent) {
          parent.replaceChild(document.createTextNode(el.textContent || ''), el);
          parent.normalize();
        }
      });
      prose.querySelectorAll('.search-target-paragraph-highlight').forEach((el) => {
        el.classList.remove('search-target-paragraph-highlight');
      });

      let targetElement: HTMLElement | null = null;
      let headingEl: HTMLElement | null = null;
      if (hash) {
        headingEl = document.getElementById(hash);
      }

      // 1. 如果存在 matchPhrase，优先在正文中定位包含该文本特征的段落
      if (matchPhrase) {
        const cleanMatch = matchPhrase.replace(/\s+/g, ' ').trim().toLowerCase();
        const candidateNodes = Array.from(prose.querySelectorAll('p, h1, h2, h3, h4, h5, h6, li, blockquote, tr, pre, td'));

        // 如果有关联的 headingEl，优先找 heading 之后的段落
        if (headingEl) {
          for (const node of candidateNodes) {
            if (headingEl.compareDocumentPosition(node) & Node.DOCUMENT_POSITION_FOLLOWING) {
              const text = (node.textContent || '').replace(/\s+/g, ' ').trim().toLowerCase();
              if (text.includes(cleanMatch) || (cleanMatch.length > 8 && text.includes(cleanMatch.slice(0, 8)))) {
                targetElement = node as HTMLElement;
                break;
              }
            }
          }
        }

        if (!targetElement) {
          for (const node of candidateNodes) {
            const text = (node.textContent || '').replace(/\s+/g, ' ').trim().toLowerCase();
            if (text.includes(cleanMatch) || (cleanMatch.length > 8 && text.includes(cleanMatch.slice(0, 8)))) {
              targetElement = node as HTMLElement;
              break;
            }
          }
        }
      }

      // 2. 如果通过 matchPhrase 没找到，但在 headingEl 范围内
      if (!targetElement && headingEl) {
        if (highlightQuery) {
          let sibling = headingEl.nextElementSibling;
          while (sibling && !['H1', 'H2', 'H3'].includes(sibling.tagName)) {
            if ((sibling.textContent || '').toLowerCase().includes(highlightQuery.toLowerCase())) {
              targetElement = sibling as HTMLElement;
              break;
            }
            sibling = sibling.nextElementSibling;
          }
        }
        if (!targetElement) {
          targetElement = headingEl;
        }
      }

      // 3. 兜底方案：首个包含 highlightQuery 的段落
      if (!targetElement && highlightQuery) {
        const cleanQuery = highlightQuery.toLowerCase();
        const candidateNodes = prose.querySelectorAll('p, h1, h2, h3, h4, h5, h6, li, blockquote');
        for (const node of candidateNodes) {
          if ((node.textContent || '').toLowerCase().includes(cleanQuery)) {
            targetElement = node as HTMLElement;
            break;
          }
        }
      }

      if (!targetElement) return;

      // 计算避让顶部常驻导航栏的平滑滚动
      const navbarOffset = 85;
      const elementTop = targetElement.getBoundingClientRect().top + window.scrollY;
      window.scrollTo({
        top: Math.max(0, elementTop - navbarOffset),
        behavior: 'smooth',
      });

      // 施加段落聚焦脉冲光晕
      targetElement.classList.add('search-target-paragraph-highlight');

      // 文本内施加关键词高亮
      if (highlightQuery) {
        highlightTextInElement(targetElement, highlightQuery);
      }

      // 3.5秒后平滑消除段落外框与背景色，恢复自然排版
      setTimeout(() => {
        if (targetElement) {
          targetElement.classList.remove('search-target-paragraph-highlight');
        }
      }, 3500);
    }

    function highlightTextInElement(element: HTMLElement, query: string) {
      const walker = document.createTreeWalker(element, NodeFilter.SHOW_TEXT, {
        acceptNode(node) {
          if (!node.textContent || !node.textContent.trim()) return NodeFilter.FILTER_REJECT;
          const parentTag = node.parentElement?.tagName;
          if (parentTag === 'SCRIPT' || parentTag === 'STYLE' || parentTag === 'MARK') {
            return NodeFilter.FILTER_REJECT;
          }
          return NodeFilter.FILTER_ACCEPT;
        },
      });

      const textNodes: Text[] = [];
      while (walker.nextNode()) {
        textNodes.push(walker.currentNode as Text);
      }

      const escaped = query.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
      const regex = new RegExp(escaped, 'i');

      for (const node of textNodes) {
        const text = node.textContent || '';
        const match = text.match(regex);
        if (match && match.index !== undefined) {
          const matchIndex = match.index;
          const matchStr = match[0];

          const before = text.slice(0, matchIndex);
          const matched = text.slice(matchIndex, matchIndex + matchStr.length);
          const after = text.slice(matchIndex + matchStr.length);

          const span = document.createElement('span');
          if (before) span.appendChild(document.createTextNode(before));

          const mark = document.createElement('mark');
          mark.className = 'search-target-highlight bg-amber-200/90 dark:bg-amber-800/80 text-amber-950 dark:text-amber-100 px-1 py-0.5 rounded font-semibold ring-2 ring-amber-400/80 dark:ring-amber-500/80 shadow-sm inline-block';
          mark.textContent = matched;
          span.appendChild(mark);

          if (after) span.appendChild(document.createTextNode(after));

          node.parentNode?.replaceChild(span, node);
          break;
        }
      }
    }

    // 页面加载及 Astro 客户端路由事件
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', () => {
        setTimeout(handleSearchHighlightAndScroll, 150);
      });
    } else {
      setTimeout(handleSearchHighlightAndScroll, 150);
    }
    document.addEventListener('astro:page-load', () => {
      setTimeout(handleSearchHighlightAndScroll, 150);
    });

    // 监听同页内搜索文段快速定位
    window.addEventListener('blog:search-jump', () => {
      setTimeout(handleSearchHighlightAndScroll, 60);
    });
  </script>

  <style is:global>
    .search-target-paragraph-highlight {
      outline: 2px solid rgba(59, 130, 246, 0.75);
      outline-offset: 6px;
      border-radius: 12px;
      background-color: rgba(59, 130, 246, 0.09);
      box-shadow: 0 0 20px -3px rgba(59, 130, 246, 0.25);
      transition: background-color 2s ease-out, outline 2s ease-out, box-shadow 2s ease-out;
    }
  </style>
</BaseLayout>
