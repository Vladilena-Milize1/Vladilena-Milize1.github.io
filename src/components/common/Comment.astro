---
import { SITE } from '../../site.config';

interface Props {
  path?: string;
}

const commentConfig = SITE.comment;
const isEnabled = commentConfig?.enable ?? false;
const repo = commentConfig?.repo?.trim() || "";
const repoId = commentConfig?.repoId?.trim() || "";
const category = commentConfig?.category?.trim() || "Announcements";
const categoryId = commentConfig?.categoryId?.trim() || "";
const mapping = commentConfig?.mapping || "pathname";
const strict = commentConfig?.strict || "0";
const reactionsEnabled = commentConfig?.reactionsEnabled || "1";
const emitMetadata = commentConfig?.emitMetadata || "0";
const inputPosition = commentConfig?.inputPosition || "bottom";
const lang = commentConfig?.lang || "zh-CN";
const lightTheme = commentConfig?.lightTheme || "light";
const darkTheme = commentConfig?.darkTheme || "dark";

const isConfigured = Boolean(repo && repoId && category && categoryId);
---

{isEnabled && (
  <section class="mt-12 pt-8 border-t border-neutral-200/80 dark:border-neutral-800/80" id="comments">
    <div class="flex items-center justify-between mb-6">
      <h3 class="text-lg font-bold text-neutral-900 dark:text-neutral-50 tracking-tight flex items-center gap-2">
        <span>评论交流</span>
      </h3>
    </div>

    {isConfigured && (
      <div
        id="giscus-container"
        class="w-full min-h-[160px]"
        data-repo={repo}
        data-repo-id={repoId}
        data-category={category}
        data-category-id={categoryId}
        data-mapping={mapping}
        data-strict={strict}
        data-reactions-enabled={reactionsEnabled}
        data-emit-metadata={emitMetadata}
        data-input-position={inputPosition}
        data-lang={lang}
        data-light-theme={lightTheme}
        data-dark-theme={darkTheme}
      ></div>
    )}

    {!isConfigured && (
      <div class="p-6 rounded-2xl bg-neutral-100/70 dark:bg-neutral-800/50 border border-neutral-200/80 dark:border-neutral-700/60 text-sm text-neutral-600 dark:text-neutral-300 space-y-4">
        <div class="font-semibold text-neutral-900 dark:text-neutral-100 flex items-center gap-2">
          <span>💬</span>
          <span>Giscus 评论系统已就绪（零服务器、永久免费）</span>
        </div>
        <p class="text-xs leading-relaxed text-neutral-500 dark:text-neutral-400">
          Giscus 将所有评论直接保存在您的 GitHub 仓库 Discussions（讨论区）中，无需任何外部服务器或数据库。只需 1 分钟完成以下 3 个极简步骤即可开启：
        </p>

        <ol class="text-xs space-y-2.5 border-t border-neutral-200/60 dark:border-neutral-700/60 pt-3 text-neutral-600 dark:text-neutral-300">
          <li class="flex items-start gap-2">
            <span class="font-bold text-sky-600 dark:text-sky-400">1.</span>
            <span>
              在仓库 <a href={`https://github.com/${repo || 'Vladilena-Milize1/Vladilena-Milize1.github.io'}/settings`} target="_blank" rel="noopener noreferrer" class="text-sky-600 dark:text-sky-400 hover:underline font-mono">Settings &rarr; General &rarr; Features</a> 中勾选开启 <strong>Discussions</strong>。
            </span>
          </li>
          <li class="flex items-start gap-2">
            <span class="font-bold text-sky-600 dark:text-sky-400">2.</span>
            <span>
              访问并安装 <a href="https://github.com/apps/giscus" target="_blank" rel="noopener noreferrer" class="text-sky-600 dark:text-sky-400 hover:underline font-semibold">Giscus GitHub App</a>，将其授权至您的博客仓库。
            </span>
          </li>
          <li class="flex items-start gap-2">
            <span class="font-bold text-sky-600 dark:text-sky-400">3.</span>
            <span>
              打开 <a href="https://giscus.app/zh-CN" target="_blank" rel="noopener noreferrer" class="text-sky-600 dark:text-sky-400 hover:underline font-semibold">giscus.app/zh-CN</a>，输入仓库名并选择分类，将生成的 <code class="font-mono bg-neutral-200/70 dark:bg-neutral-700 px-1 py-0.5 rounded text-[11px]">repoId</code> 与 <code class="font-mono bg-neutral-200/70 dark:bg-neutral-700 px-1 py-0.5 rounded text-[11px]">categoryId</code> 填入 <code class="font-mono bg-neutral-200/70 dark:bg-neutral-700 px-1 py-0.5 rounded text-[11px]">src/site.config.ts</code>。
            </span>
          </li>
        </ol>
      </div>
    )}
  </section>
)}

{isEnabled && isConfigured && (
  <script>
    function getTheme() {
      const container = document.getElementById('giscus-container');
      const isDark = document.documentElement.classList.contains('dark');
      const darkTheme = container?.getAttribute('data-dark-theme') || 'dark';
      const lightTheme = container?.getAttribute('data-light-theme') || 'light';
      return isDark ? darkTheme : lightTheme;
    }

    function initGiscus() {
      const container = document.getElementById('giscus-container');
      if (!container) return;

      // 清理已存在的 giscus 元素以适配 Astro view-transitions
      container.innerHTML = '';

      const repo = container.getAttribute('data-repo') || '';
      const repoId = container.getAttribute('data-repo-id') || '';
      const category = container.getAttribute('data-category') || '';
      const categoryId = container.getAttribute('data-category-id') || '';
      const mapping = container.getAttribute('data-mapping') || 'pathname';
      const strict = container.getAttribute('data-strict') || '0';
      const reactionsEnabled = container.getAttribute('data-reactions-enabled') || '1';
      const emitMetadata = container.getAttribute('data-emit-metadata') || '0';
      const inputPosition = container.getAttribute('data-input-position') || 'bottom';
      const lang = container.getAttribute('data-lang') || 'zh-CN';

      if (!repo || !repoId || !category || !categoryId) return;

      const script = document.createElement('script');
      script.src = 'https://giscus.app/client.js';
      script.setAttribute('data-repo', repo);
      script.setAttribute('data-repo-id', repoId);
      script.setAttribute('data-category', category);
      script.setAttribute('data-category-id', categoryId);
      script.setAttribute('data-mapping', mapping);
      script.setAttribute('data-strict', strict);
      script.setAttribute('data-reactions-enabled', reactionsEnabled);
      script.setAttribute('data-emit-metadata', emitMetadata);
      script.setAttribute('data-input-position', inputPosition);
      script.setAttribute('data-theme', getTheme());
      script.setAttribute('data-lang', lang);
      script.setAttribute('crossorigin', 'anonymous');
      script.async = true;

      container.appendChild(script);
    }

    function updateGiscusTheme() {
      const iframe = document.querySelector<HTMLIFrameElement>('iframe.giscus-frame');
      if (!iframe || !iframe.contentWindow) return;

      iframe.contentWindow.postMessage(
        {
          giscus: {
            setConfig: {
              theme: getTheme(),
            },
          },
        },
        'https://giscus.app'
      );
    }

    // 页面初始化与 Astro 视图切换重载
    initGiscus();
    document.addEventListener('astro:page-load', initGiscus);

    // 监听明暗主题切换，动态同步至 Giscus iframe
    const observer = new MutationObserver(() => {
      updateGiscusTheme();
    });

    observer.observe(document.documentElement, {
      attributes: true,
      attributeFilter: ['class'],
    });
  </script>
)}
