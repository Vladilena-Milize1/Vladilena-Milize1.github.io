---
interface Props {
  class?: string;
}

const { class: className = "" } = Astro.props;
---

<!-- 顶部常驻搜索唤起按钮 (纯文字与快捷键提示) -->
<button
  type="button"
  data-search-open-btn
  class:list={[
    "w-full flex items-center justify-between gap-2 px-3 py-1.5 text-xs rounded-xl",
    "bg-neutral-100/70 hover:bg-neutral-200/70 dark:bg-white/10 dark:hover:bg-white/15",
    "border border-neutral-200/70 dark:border-white/10 text-neutral-500 dark:text-neutral-400",
    "transition-all duration-200 focus:outline-none focus:ring-2 focus:ring-blue-500/30",
    "cursor-pointer group select-none",
    className,
  ]}
  title="搜索文章 (Ctrl + K)"
  aria-label="打开搜索 (快捷键: Ctrl + K)"
>
  <div class="flex items-center gap-2 truncate">
    <svg class="w-3.5 h-3.5 shrink-0 text-neutral-400 group-hover:text-blue-500 transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
    </svg>
    <span class="truncate text-neutral-500 dark:text-neutral-400 group-hover:text-neutral-800 dark:group-hover:text-neutral-200 transition-colors">
      键入开始搜索...
    </span>
  </div>
  <kbd class="hidden sm:inline-flex items-center px-1.5 py-0.5 text-[10px] font-mono text-neutral-400 dark:text-neutral-500 bg-neutral-200/60 dark:bg-neutral-800/80 rounded border border-neutral-300/60 dark:border-neutral-700/60 group-hover:border-blue-400/40 transition-colors" data-search-kbd>
    Ctrl K
  </kbd>
</button>

<!-- 屏幕死正中模态搜索弹窗 (严格位于视口中央，匹配参考图样式) -->
<div
  id="search-modal"
  class="fixed inset-0 z-[100] flex items-center justify-center p-4 backdrop-blur-sm bg-neutral-950/45 transition-opacity duration-200 opacity-0 pointer-events-none"
  role="dialog"
  aria-modal="true"
  aria-labelledby="search-modal-input"
>
  <div
    class="w-full max-w-xl bg-white dark:bg-neutral-900 rounded-2xl shadow-[0_20px_60px_-15px_rgba(0,0,0,0.3)] border border-neutral-200/90 dark:border-neutral-700/80 overflow-hidden flex flex-col transition-transform duration-200 scale-95"
    data-search-modal-container
  >
    <!-- 主搜索条 (对标图一：居中简约胶囊条，含放大镜线标与输入框) -->
    <div class="px-4 py-3 flex items-center gap-3">
      <!-- 简约放大镜线标 -->
      <svg class="w-5 h-5 text-neutral-400 dark:text-neutral-500 shrink-0 pointer-events-none" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
      </svg>

      <!-- 核心输入框 -->
      <input
        id="search-modal-input"
        type="search"
        autocomplete="off"
        spellcheck="false"
        placeholder="键入开始搜索"
        class="flex-1 min-w-0 bg-transparent text-sm sm:text-base text-neutral-900 dark:text-neutral-50 placeholder-neutral-400 dark:placeholder-neutral-500 focus:outline-none"
      />

      <!-- 匹配模式切换 (纯文字切换，无任何装饰贴图) -->
      <div class="flex items-center p-0.5 bg-neutral-100 dark:bg-neutral-800 rounded-lg text-xs shrink-0 select-none" role="tablist">
        <button
          type="button"
          role="tab"
          data-search-mode="title"
          aria-selected="true"
          class="search-mode-pill px-2.5 py-1 rounded-md font-medium transition-all bg-white dark:bg-neutral-900 text-neutral-900 dark:text-white shadow-sm"
        >
          仅标题
        </button>
        <button
          type="button"
          role="tab"
          data-search-mode="content"
          aria-selected="false"
          class="search-mode-pill px-2.5 py-1 rounded-md font-medium transition-all text-neutral-500 dark:text-neutral-400 hover:text-neutral-800 dark:hover:text-neutral-200"
        >
          全文内容
        </button>
      </div>

      <!-- 清空与关闭纯文字按钮 -->
      <div class="flex items-center gap-1.5 shrink-0">
        <button
          type="button"
          id="search-clear-btn"
          class="hidden text-xs text-neutral-400 hover:text-neutral-600 dark:hover:text-neutral-200 px-1.5 py-0.5 rounded hover:bg-neutral-100 dark:hover:bg-neutral-800 transition-colors"
        >
          清空
        </button>
        <button
          type="button"
          id="search-close-btn"
          class="px-2 py-0.5 text-xs text-neutral-400 dark:text-neutral-500 hover:text-neutral-700 dark:hover:text-neutral-200 bg-neutral-100 dark:bg-neutral-800 rounded border border-neutral-200 dark:border-neutral-700 transition-colors font-mono"
        >
          ESC
        </button>
      </div>
    </div>

    <!-- 向下伸展的内容展示区 (对标图二：匹配时自动展开，有滚动条，底部纯文字快捷提示) -->
    <div
      id="search-results-wrapper"
      class="hidden border-t border-neutral-100 dark:border-neutral-800 flex flex-col max-h-[62vh] sm:max-h-[55vh]"
    >
      <!-- 结果列表 -->
      <div
        id="search-results-list"
        class="flex-1 overflow-y-auto p-3 space-y-2 divide-y divide-neutral-100/70 dark:divide-neutral-800/60"
      ></div>

      <!-- 无匹配文字提示 (纯文字，无任何 emoji 或贴图) -->
      <div id="search-empty-state" class="py-8 px-4 text-center space-y-1 hidden">
        <p class="text-xs sm:text-sm text-neutral-600 dark:text-neutral-300 font-medium">
          未找到匹配内容
        </p>
        <p class="text-[11px] text-neutral-400 dark:text-neutral-500">
          可按 Tab 切换为全文内容模式重试
        </p>
      </div>

      <!-- 底部纯文字提示栏 (对标图二底部: ↑↓ 切换  ↵ 选择  Esc 关闭) -->
      <div class="px-4 py-2.5 border-t border-neutral-100 dark:border-neutral-800 bg-neutral-50/60 dark:bg-neutral-900/40 text-xs text-neutral-400 dark:text-neutral-500 flex items-center justify-center gap-6 select-none">
        <span class="inline-flex items-center gap-1">
          <span class="font-mono text-neutral-500 dark:text-neutral-400">↑↓</span>
          <span>切换</span>
        </span>
        <span class="inline-flex items-center gap-1">
          <span class="font-mono text-neutral-500 dark:text-neutral-400">↵</span>
          <span>选择</span>
        </span>
        <span class="inline-flex items-center gap-1">
          <span class="font-mono text-neutral-500 dark:text-neutral-400">Tab</span>
          <span>模式</span>
        </span>
        <span class="inline-flex items-center gap-1">
          <span class="font-mono text-neutral-500 dark:text-neutral-400">Esc</span>
          <span>关闭</span>
        </span>
      </div>
    </div>
  </div>
</div>

<script is:inline>
  (() => {
    let cachedIndex = null;
    let currentMode = 'title'; // 'title' | 'content'
    let currentMatches = [];
    let selectedIndex = -1;

    function updateKbdBadges() {
      const isMac = navigator.userAgent.includes('Mac');
      document.querySelectorAll('[data-search-kbd]').forEach((el) => {
        el.textContent = isMac ? '⌘K' : 'Ctrl K';
      });
    }

    async function getIndex() {
      if (cachedIndex) return cachedIndex;
      try {
        const res = await fetch('/search-index.json');
        cachedIndex = await res.json();
        return cachedIndex;
      } catch (err) {
        console.error('Failed to load search-index.json:', err);
        return [];
      }
    }

    function highlightText(text, query) {
      if (!query || !text) return text || '';
      const escaped = query.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
      const regex = new RegExp(`(${escaped})`, 'gi');
      return text.replace(
        regex,
        '<mark class="bg-blue-100 dark:bg-blue-900/50 text-blue-600 dark:text-blue-400 px-0.5 rounded font-semibold">$1</mark>'
      );
    }

    function extractSnippet(content, query) {
      if (!content || !query) return '';
      const lowerContent = content.toLowerCase();
      const lowerQuery = query.toLowerCase();
      const index = lowerContent.indexOf(lowerQuery);
      if (index === -1) return '';

      const beforeLen = 35;
      const afterLen = 75;
      const start = Math.max(0, index - beforeLen);
      const end = Math.min(content.length, index + query.length + afterLen);

      let snippet = content.slice(start, end).trim();
      if (start > 0) snippet = '...' + snippet;
      if (end < content.length) snippet = snippet + '...';

      return highlightText(snippet, query);
    }

    function initSearchSystem() {
      updateKbdBadges();

      // 获取 modal 并强制挂载至 document.body，确保 position: fixed 绝不受 header 的 backdrop-blur 限制！
      const modal = document.getElementById('search-modal');
      if (modal && modal.parentElement !== document.body) {
        document.body.appendChild(modal);
      }

      // 清理重复挂载的模态弹窗
      const allModals = document.querySelectorAll('#search-modal');
      if (allModals.length > 1) {
        for (let i = 1; i < allModals.length; i++) {
          allModals[i].remove();
        }
      }

      const activeModal = document.getElementById('search-modal');
      if (!activeModal) return;

      const modalContainer = activeModal.querySelector('[data-search-modal-container]');
      const input = document.getElementById('search-modal-input');
      const clearBtn = document.getElementById('search-clear-btn');
      const closeBtn = document.getElementById('search-close-btn');
      const resultsWrapper = document.getElementById('search-results-wrapper');
      const resultsList = document.getElementById('search-results-list');
      const emptyState = document.getElementById('search-empty-state');
      const modePills = activeModal.querySelectorAll('.search-mode-pill');

      if (!input || !modalContainer || !resultsWrapper) return;

      function openModal() {
        activeModal.classList.remove('opacity-0', 'pointer-events-none');
        activeModal.classList.add('opacity-100', 'pointer-events-auto');
        modalContainer.classList.remove('scale-95');
        modalContainer.classList.add('scale-100');
        document.body.style.overflow = 'hidden';

        getIndex();
        setTimeout(() => {
          input.focus();
          if (input.value.trim().length > 0) {
            executeSearch(input.value.trim());
          }
        }, 50);
      }

      function closeModal() {
        activeModal.classList.remove('opacity-100', 'pointer-events-auto');
        activeModal.classList.add('opacity-0', 'pointer-events-none');
        modalContainer.classList.remove('scale-100');
        modalContainer.classList.add('scale-95');
        document.body.style.overflow = '';
        selectedIndex = -1;
      }

      function switchMode(newMode) {
        if (currentMode === newMode) return;
        currentMode = newMode;

        modePills.forEach((btn) => {
          const isTarget = btn.getAttribute('data-search-mode') === newMode;
          btn.setAttribute('aria-selected', isTarget ? 'true' : 'false');
          if (isTarget) {
            btn.className = 'search-mode-pill px-2.5 py-1 rounded-md font-medium transition-all bg-white dark:bg-neutral-900 text-neutral-900 dark:text-white shadow-sm';
          } else {
            btn.className = 'search-mode-pill px-2.5 py-1 rounded-md font-medium transition-all text-neutral-500 dark:text-neutral-400 hover:text-neutral-800 dark:hover:text-neutral-200';
          }
        });

        if (input.value.trim().length > 0) {
          executeSearch(input.value.trim());
        }
      }

      function updateSelection() {
        const items = resultsList.querySelectorAll('[data-search-item]');
        items.forEach((item, idx) => {
          if (idx === selectedIndex) {
            item.classList.add('bg-neutral-100/80', 'dark:bg-neutral-800/80', 'ring-1', 'ring-blue-500/40');
            item.scrollIntoView({ block: 'nearest' });
          } else {
            item.classList.remove('bg-neutral-100/80', 'dark:bg-neutral-800/80', 'ring-1', 'ring-blue-500/40');
          }
        });
      }

      async function executeSearch(query) {
        selectedIndex = -1;

        if (!query) {
          resultsWrapper.classList.add('hidden');
          resultsList.innerHTML = '';
          emptyState.classList.add('hidden');
          if (clearBtn) clearBtn.classList.add('hidden');
          return;
        }

        if (clearBtn) clearBtn.classList.remove('hidden');
        resultsWrapper.classList.remove('hidden');

        const index = await getIndex();
        const queryLower = query.toLowerCase();

        let matches = [];

        if (currentMode === 'title') {
          matches = index
            .map((item) => {
              const titleMatch = item.title.toLowerCase().includes(queryLower);
              const tagMatch = item.tags && item.tags.some((t) => t.toLowerCase().includes(queryLower));
              if (titleMatch || tagMatch) {
                return { item, matchType: titleMatch ? 'title' : 'tag', snippet: '' };
              }
              return null;
            })
            .filter(Boolean);
        } else {
          matches = index
            .map((item) => {
              const titleMatch = item.title.toLowerCase().includes(queryLower);
              const tagMatch = item.tags && item.tags.some((t) => t.toLowerCase().includes(queryLower));
              const descMatch = item.description && item.description.toLowerCase().includes(queryLower);
              const contentMatch = item.content && item.content.toLowerCase().includes(queryLower);

              if (titleMatch || tagMatch || descMatch || contentMatch) {
                let snippet = '';
                if (contentMatch) {
                  snippet = extractSnippet(item.content, query);
                } else if (descMatch) {
                  snippet = extractSnippet(item.description, query);
                }
                return {
                  item,
                  matchType: titleMatch ? 'title' : (contentMatch ? 'content' : (descMatch ? 'description' : 'tag')),
                  snippet,
                };
              }
              return null;
            })
            .filter(Boolean);
        }

        currentMatches = matches;

        if (matches.length === 0) {
          resultsList.classList.add('hidden');
          emptyState.classList.remove('hidden');
          resultsList.innerHTML = '';
          return;
        }

        emptyState.classList.add('hidden');
        resultsList.classList.remove('hidden');

        resultsList.innerHTML = matches.map(({ item, snippet }, idx) => `
          <a
            href="/posts/${item.slug}"
            data-search-item
            data-index="${idx}"
            class="block p-2.5 rounded-xl hover:bg-neutral-100/70 dark:hover:bg-neutral-800/70 transition-all group select-none"
          >
            <div class="flex items-center justify-between gap-2 mb-1">
              <h4 class="text-sm font-semibold text-neutral-800 dark:text-neutral-100 group-hover:text-blue-600 dark:group-hover:text-blue-400 transition-colors leading-snug">
                ${highlightText(item.title, query)}
              </h4>
              <span class="text-[11px] font-mono text-neutral-400 dark:text-neutral-500 shrink-0">
                ${item.date}
              </span>
            </div>

            ${snippet ? `
              <p class="text-xs text-neutral-600 dark:text-neutral-300 leading-relaxed line-clamp-2 mt-1">
                ${snippet}
              </p>
            ` : (item.description ? `
              <p class="text-xs text-neutral-500 dark:text-neutral-400 line-clamp-1 mt-0.5">
                ${highlightText(item.description, query)}
              </p>
            ` : '')}

            ${item.tags && item.tags.length ? `
              <div class="flex items-center gap-1.5 mt-1.5">
                ${item.tags.map((t) => `
                  <span class="text-[10px] px-1.5 py-0.2 rounded bg-neutral-100 dark:bg-neutral-800 text-neutral-500 dark:text-neutral-400 font-mono">
                    #${highlightText(t, query)}
                  </span>
                `).join('')}
              </div>
            ` : ''}
          </a>
        `).join('');

        if (matches.length > 0) {
          selectedIndex = 0;
          updateSelection();
        }
      }

      document.querySelectorAll('[data-search-open-btn]').forEach((btn) => {
        btn.onclick = (e) => {
          e.preventDefault();
          openModal();
        };
      });

      modePills.forEach((btn) => {
        btn.onclick = () => {
          switchMode(btn.getAttribute('data-search-mode'));
        };
      });

      input.oninput = (e) => {
        executeSearch(e.target.value.trim());
      };

      if (clearBtn) {
        clearBtn.onclick = () => {
          input.value = '';
          executeSearch('');
          input.focus();
        };
      }

      if (closeBtn) {
        closeBtn.onclick = closeModal;
      }

      activeModal.onclick = (e) => {
        if (!modalContainer.contains(e.target)) {
          closeModal();
        }
      };

      input.onkeydown = (e) => {
        if (e.key === 'Tab') {
          e.preventDefault();
          switchMode(currentMode === 'title' ? 'content' : 'title');
          return;
        }

        if (e.key === 'ArrowDown') {
          e.preventDefault();
          if (currentMatches.length > 0) {
            selectedIndex = (selectedIndex + 1) % currentMatches.length;
            updateSelection();
          }
          return;
        }

        if (e.key === 'ArrowUp') {
          e.preventDefault();
          if (currentMatches.length > 0) {
            selectedIndex = (selectedIndex - 1 + currentMatches.length) % currentMatches.length;
            updateSelection();
          }
          return;
        }

        if (e.key === 'Enter') {
          e.preventDefault();
          const items = resultsList.querySelectorAll('a[data-search-item]');
          const target = items[selectedIndex] || items[0];
          if (target) {
            target.click();
          }
          return;
        }

        if (e.key === 'Escape') {
          e.preventDefault();
          closeModal();
          return;
        }
      };

      document.onkeydown = (e) => {
        if ((e.ctrlKey || e.metaKey) && e.key.toLowerCase() === 'k') {
          e.preventDefault();
          if (activeModal.classList.contains('opacity-100')) {
            closeModal();
          } else {
            openModal();
          }
          return;
        }

        if (e.key === 'Escape' && activeModal.classList.contains('opacity-100')) {
          e.preventDefault();
          closeModal();
          return;
        }

        if (e.key === '/' && !['INPUT', 'TEXTAREA'].includes(document.activeElement?.tagName)) {
          e.preventDefault();
          openModal();
        }
      };
    }

    initSearchSystem();
    document.addEventListener('astro:page-load', initSearchSystem);
  })();
</script>
