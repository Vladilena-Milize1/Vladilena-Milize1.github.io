---
import { SITE } from '../../site.config';
import ThemeToggle from '../common/ThemeToggle.astro';
import HeaderSearch from '../common/HeaderSearch.astro';

const pathname = Astro.url.pathname;
---

<header class="fixed top-0 left-0 right-0 z-40 w-full backdrop-blur-xl bg-white/60 dark:bg-neutral-950/40 border-b border-neutral-200/60 dark:border-white/10 shadow-[0_4px_20px_-4px_rgba(0,0,0,0.1)] transition-all duration-300">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between gap-3 sm:gap-4">
    <!-- 站点 Logo / 头像与用户名 -->
    <a href="/" class="flex items-center gap-2.5 text-lg font-bold tracking-tight text-neutral-900 dark:text-neutral-50 hover:text-sky-600 dark:hover:text-sky-400 transition-colors group shrink-0">
      <img
        src="/avatar.jpg"
        alt={SITE.author}
        class="w-8 h-8 rounded-full object-cover shadow-sm border border-neutral-200/80 dark:border-neutral-700/80 group-hover:scale-105 transition-transform"
      />
      <span class="tracking-tight">{SITE.author}</span>
    </a>

    <!-- 顶部搜索栏（平板/桌面端常驻展示） -->
    <div class="hidden sm:block flex-1 max-w-xs md:max-w-sm mr-auto">
      <HeaderSearch />
    </div>

    <!-- PC 端导航 -->
    <nav class="hidden md:flex items-center gap-1.5 text-sm font-medium shrink-0">
      {SITE.navItems.map((item) => {
        const isActive = item.href === '/' ? pathname === '/' : pathname.startsWith(item.href);
        return (
          <a
            href={item.href}
            class:list={[
              "px-3.5 py-1.5 rounded-lg transition-all",
              isActive
                ? "bg-neutral-900/10 text-neutral-900 dark:bg-white/15 dark:text-white font-semibold backdrop-blur-sm shadow-sm"
                : "text-neutral-600 hover:text-neutral-900 dark:text-neutral-300 dark:hover:text-white hover:bg-neutral-900/5 dark:hover:bg-white/10"
            ]}
          >
            {item.title}
          </a>
        );
      })}
      <div class="ml-3 pl-3 border-l border-neutral-200/70 dark:border-white/10 flex items-center gap-1">
        <!-- 纯享壁纸模式（隐藏内容显示完整背景） -->
        <button
          type="button"
          class="wallpaper-mode-toggle relative inline-flex items-center justify-center w-9 h-9 rounded-lg text-neutral-600 dark:text-neutral-300 hover:bg-neutral-200/60 dark:hover:bg-white/10 transition-colors focus:outline-none"
          title="隐藏页面内容以显示完整背景 (快捷键: Esc 恢复)"
          aria-label="隐藏页面内容以显示完整背景"
        >
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
          </svg>
        </button>
        <button
          type="button"
          class="zen-mode-toggle relative inline-flex items-center justify-center w-9 h-9 rounded-lg text-neutral-600 dark:text-neutral-300 hover:bg-neutral-200/60 dark:hover:bg-white/10 transition-colors focus:outline-none"
          title="开启沉浸式阅读模式"
          aria-label="开启沉浸式阅读模式"
        >
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 8V4m0 0h4M4 4l5 5m11-1V4m0 0h-4m4 0l-5 5M4 16v4m0 0h4m-4 0l5-5m11 5l-5-5m5 5v-4m0 4h-4"></path>
          </svg>
        </button>
        <ThemeToggle />
      </div>
    </nav>

    <!-- 移动端右上角控制区（壁纸模式 + 沉浸模式 + 主题按钮 + 汉堡菜单） -->
    <div class="flex items-center gap-1 md:hidden">
      <button
        type="button"
        class="wallpaper-mode-toggle inline-flex items-center justify-center w-9 h-9 rounded-lg text-neutral-600 dark:text-neutral-300 hover:bg-neutral-200/60 dark:hover:bg-neutral-800 transition-colors focus:outline-none"
        title="隐藏页面内容以显示完整背景 (快捷键: Esc 恢复)"
        aria-label="隐藏页面内容以显示完整背景"
      >
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
        </svg>
      </button>
      <button
        type="button"
        class="zen-mode-toggle inline-flex items-center justify-center w-9 h-9 rounded-lg text-neutral-600 dark:text-neutral-300 hover:bg-neutral-200/60 dark:hover:bg-neutral-800 transition-colors focus:outline-none"
        title="开启沉浸式阅读模式"
        aria-label="开启沉浸式阅读模式"
      >
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 8V4m0 0h4M4 4l5 5m11-1V4m0 0h-4m4 0l-5 5M4 16v4m0 0h4m-4 0l5-5m11 5l-5-5m5 5v-4m0 4h-4"></path>
        </svg>
      </button>
      <ThemeToggle />
      <button
        id="mobile-menu-button"
        type="button"
        class="inline-flex items-center justify-center w-10 h-10 rounded-lg text-neutral-600 dark:text-neutral-300 hover:bg-neutral-200/60 dark:hover:bg-neutral-800 transition-colors focus:outline-none"
        aria-label="打开菜单"
      >
        <svg id="menu-open-icon" class="w-6 h-6 block" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
        </svg>
        <svg id="menu-close-icon" class="w-6 h-6 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
        </svg>
      </button>
    </div>
  </div>

  <!-- 移动端下拉折叠菜单（磨砂半透） -->
  <div id="mobile-menu" class="hidden md:hidden border-t border-neutral-200/60 dark:border-white/10 bg-white/80 dark:bg-neutral-950/70 backdrop-blur-xl px-4 pt-3 pb-4 space-y-2">
    <!-- 移动端内嵌搜索栏 -->
    <div class="sm:hidden pb-1">
      <HeaderSearch />
    </div>
    {SITE.navItems.map((item) => (
      <a
        href={item.href}
        class="block px-3 py-2.5 rounded-lg text-base font-medium text-neutral-700 dark:text-neutral-300 hover:bg-neutral-100/70 dark:hover:bg-white/10 transition-colors"
      >
        {item.title}
      </a>
    ))}
  </div>
</header>

<script is:inline>
  const menuBtn = document.getElementById("mobile-menu-button");
  const menu = document.getElementById("mobile-menu");
  const openIcon = document.getElementById("menu-open-icon");
  const closeIcon = document.getElementById("menu-close-icon");

  if (menuBtn && menu && openIcon && closeIcon) {
    menuBtn.addEventListener("click", () => {
      const isHidden = menu.classList.toggle("hidden");
      openIcon.classList.toggle("hidden", !isHidden);
      closeIcon.classList.toggle("hidden", isHidden);
    });
  }
</script>
