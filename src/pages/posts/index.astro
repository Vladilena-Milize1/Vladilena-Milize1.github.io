---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const posts = await getCollection('blog', ({ data }) => !data.draft);
const sortedPosts = posts.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<BaseLayout title="全部文章" description="这里归档了所有已发表的技术思考、架构探索与教程。">
  <div class="w-full max-w-4xl p-6 sm:p-8 rounded-2xl bg-white/75 dark:bg-neutral-900/75 backdrop-blur-md border border-neutral-200/80 dark:border-neutral-800/80 shadow-sm">
    <header class="mb-10 pb-6 border-b border-neutral-200 dark:border-neutral-800">
      <h1 class="text-3xl sm:text-4xl font-extrabold tracking-tight text-neutral-900 dark:text-neutral-50 mb-3">
       Note
      </h1>
      <p class="text-neutral-600 dark:text-neutral-400 text-sm sm:text-base">
        共 {sortedPosts.length} 篇文章。
      </p>
    </header>

    <div class="divide-y divide-neutral-200 dark:divide-neutral-800">
      {sortedPosts.map((post) => {
        const formattedDate = new Intl.DateTimeFormat('zh-CN', {
          year: 'numeric',
          month: 'short',
          day: 'numeric',
        }).format(post.data.date);

        return (
          <article class="py-6 first:pt-0 last:pb-0 flex flex-col sm:flex-row sm:items-baseline justify-between gap-2 sm:gap-6 group">
            <div class="space-y-1.5 flex-1">
              <h2 class="text-lg font-semibold text-neutral-900 dark:text-neutral-100 group-hover:text-sky-600 dark:group-hover:text-sky-400 transition-colors">
                <a href={`/posts/${post.slug}`}>
                  {post.data.title}
                </a>
              </h2>
              <p class="text-sm text-neutral-600 dark:text-neutral-400 line-clamp-2 leading-relaxed">
                {post.data.description}
              </p>
              <div class="flex flex-wrap gap-2 pt-1">
                {post.data.tags.map((tag) => (
                  <span class="px-2 py-0.5 rounded text-xs bg-neutral-100 dark:bg-neutral-800/60 text-neutral-600 dark:text-neutral-400">
                    #{tag}
                  </span>
                ))}
              </div>
            </div>
            <time
              datetime={post.data.date.toISOString()}
              class="text-xs sm:text-sm font-mono text-neutral-400 dark:text-neutral-500 shrink-0"
            >
              {formattedDate}
            </time>
          </article>
        );
      })}
    </div>
  </div>
</BaseLayout>
