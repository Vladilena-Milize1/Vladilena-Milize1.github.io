---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE } from '../site.config';
import { getCollection } from 'astro:content';

const posts = await getCollection('blog', ({ data }) => !data.draft);
const sortedPosts = posts.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf()).slice(0, 5);
---

<BaseLayout>
  <!-- Hero 个人介绍区域 -->
  <section class="py-6 sm:py-10 border-b border-neutral-200 dark:border-neutral-800">
    <div class="max-w-3xl">
      <h1 class="text-3xl sm:text-5xl font-extrabold tracking-tight text-neutral-900 dark:text-neutral-50 mb-4 leading-tight">
        你好，我是 <span class="text-transparent bg-clip-text bg-gradient-to-r from-sky-500 to-indigo-600 dark:from-sky-400 dark:to-indigo-400">{SITE.author}</span>
      </h1>
      <p class="text-lg sm:text-xl text-neutral-600 dark:text-neutral-300 leading-relaxed mb-6">
        {SITE.description}
      </p>
      <div class="flex flex-wrap items-center gap-3 text-sm">
        <a
          href="/posts"
          class="inline-flex items-center justify-center px-4 py-2.5 rounded-lg font-semibold bg-neutral-900 text-neutral-50 dark:bg-neutral-100 dark:text-neutral-900 hover:opacity-90 transition-opacity"
        >
          浏览所有博文
        </a>
        <a
          href="/about"
          class="inline-flex items-center justify-center px-4 py-2.5 rounded-lg font-semibold border border-neutral-300 dark:border-neutral-700 hover:bg-neutral-100 dark:hover:bg-neutral-800 transition-colors"
        >
          关于我
        </a>
      </div>
    </div>
  </section>

  <!-- 最新文章列表 -->
  <section class="py-10">
    <div class="flex items-center justify-between mb-8">
      <h2 class="text-xl sm:text-2xl font-bold tracking-tight text-neutral-900 dark:text-neutral-50">
        最新发表
      </h2>
      <a
        href="/posts"
        class="text-sm font-medium text-sky-600 dark:text-sky-400 hover:underline"
      >
        查看全部 ({posts.length}) →
      </a>
    </div>

    <div class="space-y-6">
      {sortedPosts.map((post) => {
        const formattedDate = new Intl.DateTimeFormat('zh-CN', {
          year: 'numeric',
          month: 'short',
          day: 'numeric',
        }).format(post.data.date);

        return (
          <article class="group relative flex flex-col sm:flex-row sm:items-baseline justify-between gap-2 sm:gap-4 p-4 -mx-4 rounded-xl hover:bg-neutral-100/70 dark:hover:bg-neutral-900/60 transition-colors">
            <div class="space-y-1.5 flex-1">
              <h3 class="text-lg font-semibold text-neutral-900 dark:text-neutral-100 group-hover:text-sky-600 dark:group-hover:text-sky-400 transition-colors">
                <a href={`/posts/${post.slug}`}>
                  <span class="absolute inset-0 z-10" />
                  {post.data.title}
                </a>
              </h3>
              <p class="text-sm text-neutral-600 dark:text-neutral-400 line-clamp-2 leading-relaxed">
                {post.data.description}
              </p>
              <div class="flex flex-wrap gap-2 pt-1">
                {post.data.tags.map((tag) => (
                  <span class="text-xs text-neutral-500 dark:text-neutral-400">
                    #{tag}
                  </span>
                ))}
              </div>
            </div>
            <time
              datetime={post.data.date.toISOString()}
              class="text-xs sm:text-sm font-mono text-neutral-400 dark:text-neutral-500 shrink-0"
            >
              {formattedDate}
            </time>
          </article>
        );
      })}
    </div>
  </section>
</BaseLayout>
