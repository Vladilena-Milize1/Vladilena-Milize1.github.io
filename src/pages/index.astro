---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const posts = await getCollection('blog', ({ data }) => !data.draft);
const sortedPosts = posts.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf()).slice(0, 6);
---

<BaseLayout>
  <!-- 右侧顶部精简欢迎区 -->
  <section class="mb-8 p-6 sm:p-8 rounded-2xl bg-gradient-to-br from-white/90 via-sky-50/30 to-indigo-50/40 dark:from-neutral-900/90 dark:via-neutral-900/50 dark:to-neutral-950 border border-neutral-200/80 dark:border-neutral-800/80 shadow-sm">
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
      <div>
        <h1 class="text-2xl sm:text-3xl font-extrabold tracking-tight text-neutral-900 dark:text-neutral-50 mb-2">
          欢迎来到我的数字花园 🌱
        </h1>
        <p class="text-sm sm:text-base text-neutral-600 dark:text-neutral-300 max-w-xl leading-relaxed">
          这里记录关于全栈开发、系统架构、Rust 实践与日常思考。保持对技术底层的好奇心与专注。
        </p>
      </div>
      <div class="flex items-center gap-2 shrink-0">
        <a
          href="/posts"
          class="inline-flex items-center justify-center px-4 py-2 rounded-xl text-xs font-semibold bg-neutral-900 text-neutral-50 dark:bg-neutral-100 dark:text-neutral-900 hover:opacity-90 shadow-sm transition-opacity"
        >
          全部文章 ({posts.length})
        </a>
      </div>
    </div>
  </section>

  <!-- 最新文章展示区（双栏下的优雅卡片流） -->
  <section class="space-y-6">
    <div class="flex items-center justify-between">
      <h2 class="text-xl font-bold tracking-tight text-neutral-900 dark:text-neutral-50 flex items-center gap-2">
        <span class="w-2 h-2 rounded-full bg-sky-500 inline-block"></span>
        最新文章
      </h2>
      <a
        href="/posts"
        class="text-xs font-semibold text-sky-600 dark:text-sky-400 hover:underline"
      >
        浏览全部 →
      </a>
    </div>

    <div class="grid grid-cols-1 gap-4">
      {sortedPosts.map((post) => {
        const formattedDate = new Intl.DateTimeFormat('zh-CN', {
          year: 'numeric',
          month: 'short',
          day: 'numeric',
        }).format(post.data.date);

        return (
          <article class="group relative p-5 rounded-2xl bg-white/60 dark:bg-neutral-900/60 backdrop-blur-sm border border-neutral-200/70 dark:border-neutral-800/70 hover:border-sky-500/50 dark:hover:border-sky-500/50 hover:shadow-md transition-all">
            <div class="flex flex-col sm:flex-row sm:items-baseline justify-between gap-2 mb-2">
              <h3 class="text-lg font-bold text-neutral-900 dark:text-neutral-100 group-hover:text-sky-600 dark:group-hover:text-sky-400 transition-colors">
                <a href={`/posts/${post.slug}`}>
                  <span class="absolute inset-0 z-10" />
                  {post.data.title}
                </a>
              </h3>
              <time
                datetime={post.data.date.toISOString()}
                class="text-xs font-mono text-neutral-400 dark:text-neutral-500 shrink-0"
              >
                {formattedDate}
              </time>
            </div>
            <p class="text-sm text-neutral-600 dark:text-neutral-400 line-clamp-2 leading-relaxed mb-3">
              {post.data.description}
            </p>
            <div class="flex flex-wrap gap-1.5 pt-1">
              {post.data.tags.map((tag) => (
                <span class="px-2 py-0.5 rounded-md text-[11px] font-medium bg-neutral-100 dark:bg-neutral-800 text-neutral-600 dark:text-neutral-300">
                  #{tag}
                </span>
              ))}
            </div>
          </article>
        );
      })}
    </div>
  </section>
</BaseLayout>
